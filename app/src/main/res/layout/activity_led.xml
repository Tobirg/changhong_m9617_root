<?xml version="1.0" encoding="utf-8"?>
<!-- Power LED settings (ledctl kernel module): module status, standby mode, mode while the TV is on. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/led_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <!-- Module status -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/led_module_title" />

                <TextView style="@style/PermDesc" android:text="@string/led_module_desc" />

                <LinearLayout style="@style/PermRow">

                    <TextView
                        android:id="@+id/ledStatus"
                        style="@style/PermStatus"
                        tools:text="Работает (версия 2.0)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledRemove"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/led_remove"
                        android:textColor="@color/danger"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledInstall"
                        style="@style/PermButton"
                        android:layout_width="220dp"
                        tools:text="Установить" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Standby -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/led_sleep_title" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ledSleepGroup"
                    style="@style/LedGroup"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledSleepOff"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledSleepOn"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_on" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledSleepBlink"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_blink" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/ledSleepLevelRow"
                    style="@style/PermRow">

                    <TextView
                        android:id="@+id/ledSleepLevel"
                        style="@style/LedLevelText"
                        tools:text="Яркость: 100 %" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledSleepMinus"
                        style="@style/LedStepButton"
                        android:text="−" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledSleepPlus"
                        style="@style/LedStepButton"
                        android:layout_marginStart="8dp"
                        android:text="+" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- While the TV is on -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/led_on_title" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ledOnGroup"
                    style="@style/LedGroup"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnStock"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_stock" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnOff"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnOn"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_on" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnBlink"
                        style="@style/LedModeButton"
                        android:text="@string/led_mode_blink" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/ledOnLevelRow"
                    style="@style/PermRow">

                    <TextView
                        android:id="@+id/ledOnLevel"
                        style="@style/LedLevelText"
                        tools:text="Яркость: 30 %" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnMinus"
                        style="@style/LedStepButton"
                        android:text="−" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ledOnPlus"
                        style="@style/LedStepButton"
                        android:layout_marginStart="8dp"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    style="@style/PermDesc"
                    android:layout_marginTop="6dp"
                    android:text="@string/led_on_note" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ledDone"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:layout_weight="2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/perm_done_button"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
