<?xml version="1.0" encoding="utf-8"?>
<!-- Three compact cards (status and button on one line) so the screen fits a 1080p TV without scrolling. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"
            android:text="@string/perm_screen_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <!-- All files access -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/perm_storage_title" />

                <TextView style="@style/PermDesc" android:text="@string/perm_storage_desc" />

                <LinearLayout style="@style/PermRow">

                    <TextView
                        android:id="@+id/permStorageStatus"
                        style="@style/PermStatus"
                        tools:text="Не разрешено" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permStorageButton"
                        style="@style/PermButton"
                        tools:text="Выдать разрешение" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Install unknown apps -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/perm_install_title" />

                <TextView style="@style/PermDesc" android:text="@string/perm_install_desc" />

                <LinearLayout style="@style/PermRow">

                    <TextView
                        android:id="@+id/permInstallStatus"
                        style="@style/PermStatus" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permInstallButton"
                        style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Developer options and USB debugging (adb) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PermCard"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout style="@style/PermCardBody">

                <TextView style="@style/PermTitle" android:text="@string/perm_adb_title" />

                <TextView style="@style/PermDesc" android:text="@string/perm_adb_desc" />

                <LinearLayout style="@style/PermRow">

                    <TextView
                        android:id="@+id/permAdbStatus"
                        style="@style/PermStatus" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permAdbButton"
                        style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permDone"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:layout_weight="2"
                android:focusedByDefault="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/perm_done_button"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
